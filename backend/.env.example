# Copy to backend/.env (ignored). Local values come from `supabase status`.
# The iOS app only ever gets SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<publishable key from supabase status>

# Server-side jobs only (orphan cleanup). Never put this in the app or commit it.
SUPABASE_SECRET_KEY=<secret/service-role key, server-side only>
